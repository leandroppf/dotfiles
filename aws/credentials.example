# Example ~/.aws/credentials. Copy to ~/.aws/credentials, fill in [default],
# and leave [mfa] alone — awsmfa manages it.
#
# NEVER commit the real file. `chmod 600 ~/.aws/credentials`.

# Your long-lived IAM user keys, created at:
#   IAM -> Users -> your user -> Security credentials -> Create access key
[default]
aws_access_key_id = AKIAIOSFODNN7EXAMPLE
aws_secret_access_key = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Written by `awsmfa` on every refresh. The session token is what proves to AWS
# that an MFA code was presented; without it the other two keys are rejected.
# x_session_expires is not an AWS setting — awsmfa records it so awsmfa_status
# can tell you how long is left.
[mfa]
aws_access_key_id = ASIAIOSFODNN7EXAMPLE
aws_secret_access_key = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
aws_session_token = FwoGZXIvYXdzEXAMPLETOKEN...
x_session_expires = 2026-01-01T12:00:00+00:00
